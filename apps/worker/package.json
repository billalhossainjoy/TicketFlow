  },
  "devDependencies": {
    "@ticketflow/eslint-config": "workspace:*",
    "@ticketflow/tsconfig": "workspace:*",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}