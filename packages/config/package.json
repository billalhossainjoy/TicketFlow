  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@ticketflow/eslint-config": "workspace:*",
    "@ticketflow/tsconfig": "workspace:*",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "typescript": "^7.0.2"
  }
}